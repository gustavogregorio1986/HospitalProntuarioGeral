<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalProntuario.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalProntuario.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="sidebar">
            <nav class="menu">

                <a asp-page="/Index">🏠 Home</a>

                <details>
                    <summary>👥 Administração</summary>

                    <div class="submenu">
                        <a asp-controller="Usuario" asp-action="ListarUsuarios">Usuários</a>
                        <a asp-controller="Usuario" asp-action="ListarDeRecepcionistas">Recepcionistas</a>
                        <a asp-controller="Usuario" asp-action="CadastroDeUsuario"> cadastrar usuario</a>
                        <a asp-controller="Usuario" asp-action="CadastroDeRecepcionistas">Cadastrar Recepcionistas</a>
                    </div>
                </details>

                <details>
                    <summary>👨‍⚕️ Pacientes</summary>

                    <div class="submenu">
                        <a asp-controller="Paciente" asp-action="ListarDePacientes">Listar Pacientes</a>
                        <a asp-controller="Paciente" asp-action="CadastroDePaciente">Cadastrar Paciente</a>
                    </div>
                </details>

                <details>
                    <summary>🩺 Médicos</summary>

                    <div class="submenu">
                        <a asp-controller="Medico" asp-action="ListarDeMedicos">Listar Médicos</a>
                        <a asp-controller="Medico" asp-action="CadastroDeMedico">Cadastrar Médico</a>
                    </div>
                </details>

                <details>
                    <summary>🏥 Internações</summary>

                    <div class="submenu">
                        <a asp-controller="Internacao" asp-action="ListarDeInternacoes">Listar Internações</a>
                        <a asp-controller="Internacao" asp-action="CadastroDeInternacao">Nova Internação</a>
                    </div>
                </details>

                <details>
                    <summary>🔪 Cirurgias</summary>

                    <div class="submenu">
                        <a asp-controller="Cirurgia" asp-action="ListarDeCirurgias">Listar Cirurgias</a>
                        <a asp-controller="Cirurgia" asp-action="CadastroDeCirurgia">Cadastrar Cirurgia</a>
                    </div>
                </details>

                <details>
                    <summary>💳 Pagamentos</summary>

                    <div class="submenu">
                        <a asp-controller="Pagamento" asp-action="ListarDePagamentos">Listar Pagamentos</a>
                        <a asp-controller="Pagamento" asp-action="CadastroDePagamento">Novo Pagamento</a>
                    </div>
                </details>

                <details>
                    <summary>📋 Planos de Saúde</summary>

                    <div class="submenu">
                        <a asp-controller="PlanoDeSaude" asp-action="ListarDePlanos">Listar</a>
                        <a asp-controller="PlanoDeSaude" asp-action="CadastroDePlano">Cadastrar</a>
                    </div>
                </details>

            </nav>
        </div>
    </header>
    <!-- Conteúdo principal -->
    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- Rodapé -->
    <footer>
        © 2026 - HospitalProntuario.Web - Desnevolvidoi por Gustavo
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
