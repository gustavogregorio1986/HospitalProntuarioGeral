<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalProntuario.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalProntuario.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Menu lateral -->
        <div class="sidebar">
            <nav>
                <a asp-page="/Index">🏠 Home</a>
                <a asp-page="/Pacientes">👨‍⚕️ Pacientes</a>
                <a asp-page="/Medicos">🩺 Médicos</a>
                <a asp-page="/Internacoes">🏥 Internações</a>
                <a asp-page="/Cirurgias">🔪 Cirurgias</a>
                <a asp-page="/Pagamentos">💳 Pagamentos</a>
                <a asp-page="/Planos">📋 Planos de Saúde</a>
            </nav>
        </div>
    </header>
    <!-- Conteúdo principal -->
    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- Rodapé -->
    <footer>
        © 2026 - HospitalProntuario.Web - Desnevolvidoi por Gustavo
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
