<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalProntuario.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalProntuario.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="sidebar">
            <nav class="menu">

                <a asp-page="/Index">🏠 Home</a>

                <details>
                    <summary>👥 Administração</summary>

                    <div class="submenu">
                        <a asp-page="/Usuarios">Usuários</a>
                        <a asp-page="/Recepcionistas">Recepcionistas</a>
                    </div>
                </details>

                <details>
                    <summary>👨‍⚕️ Pacientes</summary>

                    <div class="submenu">
                        <a asp-page="/Pacientes">Listar</a>
                        <a asp-page="/Pacientes/Create">Cadastrar</a>
                    </div>
                </details>

                <details>
                    <summary>🩺 Médicos</summary>

                    <div class="submenu">
                        <a asp-page="/Medicos">Listar</a>
                        <a asp-page="/Medicos/Create">Cadastrar</a>
                    </div>
                </details>

                <details>
                    <summary>🏥 Internações</summary>

                    <div class="submenu">
                        <a asp-page="/Internacoes">Listar</a>
                        <a asp-page="/Internacoes/Create">Nova Internação</a>
                    </div>
                </details>

                <details>
                    <summary>🔪 Cirurgias</summary>

                    <div class="submenu">
                        <a asp-page="/Cirurgias">Listar</a>
                        <a asp-page="/Cirurgias/Create">Cadastrar</a>
                    </div>
                </details>

                <details>
                    <summary>💳 Pagamentos</summary>

                    <div class="submenu">
                        <a asp-page="/Pagamentos">Listar</a>
                        <a asp-page="/Pagamentos/Create">Novo Pagamento</a>
                    </div>
                </details>

                <details>
                    <summary>📋 Planos de Saúde</summary>

                    <div class="submenu">
                        <a asp-page="/Planos">Listar</a>
                        <a asp-page="/Planos/Create">Cadastrar</a>
                    </div>
                </details>

            </nav>
        </div>
    </header>
    <!-- Conteúdo principal -->
    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- Rodapé -->
    <footer>
        © 2026 - HospitalProntuario.Web - Desnevolvidoi por Gustavo
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
